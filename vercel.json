{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/admin-dashboard.html", "destination": "/api/pages?page=admin-dashboard.html" },
    { "source": "/admin-email.html", "destination": "/api/pages?page=admin-email.html" },
    { "source": "/affiliate-register.html", "destination": "/api/pages?page=affiliate-register.html" },
    { "source": "/results-preview.html", "destination": "/api/pages?page=results-preview.html" },
    { "source": "/results-full.html", "destination": "/api/pages?page=results-full.html" },
    { "source": "/affiliate-dashboard.html", "destination": "/api/pages?page=affiliate-dashboard.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
